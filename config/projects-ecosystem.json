[
    {
        "name":  "redpulse.analyze",
        "project":  "redpulse",
        "version":  "1.0.0",
        "description":  "Evaluate maintenance risk from baseline and current vectors",
        "mode":  "http",
        "protocol":  "redpulse_v400",
        "workspace_binding":  "red",
        "effect":  "read",
        "approval":  false,
        "endpoint":  "http://127.0.0.1:8002/api/v1/platform/v40/intelligence/evaluate",
        "max_attempts":  2,
        "input_schema":  {
                             "type":  "object",
                             "properties":  {
                                                "machine_id":  {
                                                                   "type":  "string",
                                                                   "minLength":  1,
                                                                   "maxLength":  200
                                                               },
                                                "baseline":  {
                                                                 "type":  "array",
                                                                 "items":  {
                                                                               "type":  "number"
                                                                           },
                                                                 "minItems":  1,
                                                                 "maxItems":  512
                                                             },
                                                "current":  {
                                                                "type":  "array",
                                                                "items":  {
                                                                              "type":  "number"
                                                                          },
                                                                "minItems":  1,
                                                                "maxItems":  512
                                                            },
                                                "drift_score":  {
                                                                    "type":  "number",
                                                                    "minimum":  0,
                                                                    "maximum":  1
                                                                },
                                                "trajectory_match":  {
                                                                         "type":  "number",
                                                                         "minimum":  0,
                                                                         "maximum":  1
                                                                     },
                                                "uncertainty":  {
                                                                    "type":  "number",
                                                                    "minimum":  0,
                                                                    "maximum":  1
                                                                }
                                            },
                             "required":  [
                                              "machine_id",
                                              "baseline",
                                              "current",
                                              "drift_score",
                                              "trajectory_match"
                                          ],
                             "additionalProperties":  false
                         },
        "output_schema":  {
                              "type":  "object",
                              "required":  [
                                               "simulated",
                                               "project",
                                               "result",
                                               "evidence"
                                           ],
                              "properties":  {
                                                 "simulated":  {
                                                                   "const":  false
                                                               },
                                                 "project":  {
                                                                 "const":  "redpulse"
                                                             },
                                                 "evidence":  {
                                                                  "type":  "array",
                                                                  "minItems":  1
                                                              }
                                             }
                          }
    },
    {
        "name":  "redguard.inspect",
