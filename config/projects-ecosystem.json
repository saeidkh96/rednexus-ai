    {
        "name":  "redpa.chat",
        "project":  "redpa",
        "version":  "1.0.0",
        "description":  "Send a message in an existing RedPA conversation; persists messages and invokes its configured model",
        "mode":  "http",
        "protocol":  "redpa_v191",
        "workspace_binding":  "red",
        "effect":  "write",
        "approval":  true,
        "endpoint":  "http://127.0.0.1:8111/api/v1/chat",
        "max_attempts":  1,
        "input_schema":  {
                             "type":  "object",
                             "properties":  {
                                                "conversation_id":  {
                                                                        "type":  "string",
                                                                        "pattern":  "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$"
                                                                    },
                                                "content":  {
                                                                "type":  "string",
                                                                "minLength":  1,
                                                                "maxLength":  16000,
                                                                "pattern":  "\\S"
                                                            }
                                            },
                             "required":  [
                                              "conversation_id",
                                              "content"
                                          ],
                             "additionalProperties":  false
                         },
        "output_schema":  {
                              "type":  "object",
                              "required":  [
                                               "simulated",
                                               "project",
                                               "result",
                                               "evidence"
                                           ],
                              "properties":  {
                                                 "simulated":  {
                                                                   "const":  false
                                                               },
                                                 "project":  {
                                                                 "const":  "redpa"
                                                             },
                                                 "evidence":  {
                                                                  "type":  "array",
                                                                  "minItems":  1
                                                              }
                                             }
                          },
        "credential_env":  "NEXUS_REDPA_TOKEN",
        "timeout_seconds":  60
    },
    {
        "name":  "redworld.snapshot",
        "project":  "redworld",
        "version":  "1.0.0",
        "description":  "Read the real RedWorld snapshot",
        "mode":  "http",
        "protocol":  "redworld_v200",
        "workspace_binding":  "red",
        "effect":  "read",
        "approval":  false,
        "endpoint":  "http://127.0.0.1:8100/api/v1/world",
        "timeout_seconds":  30,
        "max_attempts":  2,
        "input_schema":  {
                             "type":  "object",
                             "properties":  {
                                                "steps":  {
                                                              "type":  "integer",
                                                              "minimum":  1,
                                                              "maximum":  10
                                                          },
                                                "objective":  {
                                                                  "type":  "string"
                                                              },
                                                "previous":  {
                                                                 "type":  "object"
                                                             }
                                            },
                             "additionalProperties":  false
                         },
        "output_schema":  {
                              "type":  "object",
                              "required":  [
                                               "world",
                                               "project_version",
                                               "evidence",
                                               "advanced_steps"
                                           ],
                              "properties":  {
                                                 "project_version":  {
                                                                         "const":  "2.0.0"
                                                                     },
                                                 "world":  {
                                                               "type":  "object",
                                                               "required":  [
                                                                                "tick",
                                                                                "population"
                                                                            ]
                                                           }
                                             }
                          },
        "estimated_cost_microunits":  100
    },
