                              "properties":  {
                                                 "simulated":  {
                                                                   "const":  false
                                                               },
                                                 "project":  {
                                                                 "const":  "redguard"
                                                             },
                                                 "evidence":  {
                                                                  "type":  "array",
                                                                  "minItems":  1
                                                              }
                                             }
                          }
    },
