  {
    "name": "redworld.snapshot",
    "project": "redworld",
    "version": "1.0.0",
    "description": "Read the real RedWorld snapshot",
    "mode": "http",
    "protocol": "redworld_v140",
    "workspace_binding": "red",
    "effect": "read",
    "approval": false,
    "endpoint": "http://127.0.0.1:8100/api/v1/world",
    "timeout_seconds": 30,
    "max_attempts": 2,
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "objective": {
          "type": "string"
        },
        "previous": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "world",
        "project_version",
        "evidence",
        "advanced_steps"
      ],
      "properties": {
        "project_version": {
          "const": "1.4.0"
        },
        "world": {
          "type": "object",
          "required": [
            "tick",
            "population"
          ]
        }
      }
    },
    "estimated_cost_microunits": 100
  },
  {
    "name": "redworld.advance",
    "project": "redworld",
    "version": "1.0.0",
    "description": "Advance the real RedWorld simulation after human approval",
    "mode": "http",
    "protocol": "redworld_v140",
    "workspace_binding": "red",
    "effect": "write",
    "approval": true,
    "endpoint": "http://127.0.0.1:8100/api/v1/world",
    "timeout_seconds": 30,
    "max_attempts": 1,
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "objective": {
          "type": "string"
        },
        "previous": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "required": [
        "world",
        "project_version",
        "evidence",
        "advanced_steps"
      ],
      "properties": {
        "project_version": {
          "const": "1.4.0"
        },
        "world": {
          "type": "object",
          "required": [
            "tick",
            "population"
          ]
        }
      }
    },
    "estimated_cost_microunits": 100
  }
