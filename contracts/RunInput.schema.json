{
  "$defs": {
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "maximum": 19,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "pointer": {
          "default": "",
          "maxLength": 500,
          "pattern": "^(|/.*)$",
          "title": "Pointer",
          "type": "string"
        },
        "format": {
          "default": "value",
          "enum": [
            "value",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "op": {
          "default": "eq",
          "enum": [
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "exists"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "step"
      ],
      "title": "Condition",
      "type": "object"
    },
    "OutputBinding": {
      "additionalProperties": false,
      "properties": {
        "step": {
          "maximum": 19,
          "minimum": 0,
          "title": "Step",
          "type": "integer"
        },
        "pointer": {
          "default": "",
          "maxLength": 500,
          "pattern": "^(|/.*)$",
          "title": "Pointer",
          "type": "string"
        },
        "format": {
          "default": "value",
          "enum": [
            "value",
            "json"
          ],
          "title": "Format",
          "type": "string"
        }
      },
      "required": [
        "step"
      ],
      "title": "OutputBinding",
      "type": "object"
    },
    "StepInput": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        },
        "use_previous": {
          "default": false,
          "title": "Use Previous",
          "type": "boolean"
        },
        "bindings": {
          "additionalProperties": {
            "$ref": "#/$defs/OutputBinding"
          },
          "maxProperties": 50,
          "title": "Bindings",
          "type": "object"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "capability"
      ],
      "title": "StepInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/StepInput"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "budget_microunits": {
      "default": 1000000,
      "maximum": 1000000000,
      "minimum": 0,
      "title": "Budget Microunits",
      "type": "integer"
    },
    "max_tool_calls": {
      "default": 20,
      "maximum": 80,
      "minimum": 1,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "deadline_seconds": {
      "default": 3600,
      "maximum": 86400,
      "minimum": 10,
      "title": "Deadline Seconds",
      "type": "integer"
    }
  },
  "required": [
    "title",
    "steps"
  ],
  "title": "RunInput",
  "type": "object"
}
