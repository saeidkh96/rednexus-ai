  "components": {
    "schemas": {
      "AccessInput": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "operator",
              "reviewer",
              "viewer"
            ],
            "title": "Role"
          },
          "grants": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Grants"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role"
        ],
        "title": "AccessInput"
      },
      "AgentInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Capabilities"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "ordered",
              "model"
            ],
            "title": "Strategy",
            "default": "ordered"
          },
          "budget_microunits": {
            "type": "integer",
            "maximum": 1000000000.0,
            "minimum": 0.0,
            "title": "Budget Microunits",
            "default": 1000000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "capabilities"
        ],
        "title": "AgentInput"
      },
      "EventInput": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Id"
          },
          "source": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Source"
          },
          "type": {
            "type": "string",
